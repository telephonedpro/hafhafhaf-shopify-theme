<section class="collection-page page-width"><div class="eyebrow">The collection</div><h1 class="collection-title">Smart care for everyday life.</h1><div class="products-grid">{% for product in collection.products %}<a class="card" href="{{ product.url }}"><div class="card-media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '500,800,1100' }}{% endif %}</div><div class="card-info"><h3 class="card-title">{{ product.title }}</h3><div class="card-price">{{ product.price | money }}</div></div></a>{% endfor %}</div></section>{% schema %}{"name":"Premium collection"}{% endschema %}