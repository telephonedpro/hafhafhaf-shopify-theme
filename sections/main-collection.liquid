<section class="collection page-width"><div class="collection__intro"><div><div class="eyebrow">HafHafHaf collection</div><h1>{{ collection.title | default:'Smart pet care' }}</h1></div><p>Thoughtfully selected technology for feeding, hygiene and the everyday moments in between.</p></div><div class="product-grid">{% for product in collection.products %}<a class="product-card reveal" href="{{ product.url }}"><div class="product-card__media">{% if product.featured_image %}{{ product.featured_image | image_url: width:2400 | image_tag: loading:'lazy', widths:'800,1200,1600,2000,2400', sizes:'(max-width: 900px) 50vw, 33vw', alt:product.title }}{% endif %}</div><div class="product-card__meta"><div><div class="product-card__title">{{ product.title }}</div>{% if product.metafields.reviews.rating_count %}<div class="price" style="margin-top:6px">★ {{ product.metafields.reviews.rating.value.rating | round:1 }} · {{ product.metafields.reviews.rating_count }} reviews</div>{% endif %}</div><div class="product-card__price">{{ product.price | money }}</div></div></a>{% else %}<p>No products are currently available.</p>{% endfor %}</div></section>{% schema %}{"name":"Premium collection"}{% endschema %}