<section class="product-page page-width"><div class="product-layout"><div class="gallery">{% for image in product.images %}{{ image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '700,1000,1400,1600' }}{% endfor %}</div><div class="product-summary"><div class="eyebrow">{{ product.type | default: 'Smart pet care' }}</div><h1>{{ product.title }}</h1><div class="product-price">{{ product.selected_or_first_available_variant.price | money }}</div><div class="product-description">{{ product.description }}</div>{% form 'product', product %}{% unless product.has_only_default_variant %}<select class="variant-select" name="id" aria-label="Choose an option">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant.id == product.selected_or_first_available_variant.id %}selected{% endif %}>{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<select class="qty" name="quantity" aria-label="Quantity"><option value="1">Quantity: 1</option><option value="2">Quantity: 2</option><option value="3">Quantity: 3</option></select><button class="button buy" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %}</button>{% endform %}<div class="details"><div class="detail">Secure checkout and protected payment</div><div class="detail">Designed for everyday pet care</div><div class="detail">Support when you need it</div></div></div></div></section>{% schema %}{"name":"Premium product"}{% endschema %}