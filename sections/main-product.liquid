<section class="product-page page-width"><div class="product-layout"><div class="product-gallery">{% for image in product.images %}<div class="product-gallery__item reveal">{{ image | image_url: width:3840 | image_tag: loading:forloop.first | default:'lazy', widths:'1000,1600,2200,3000,3840', sizes:'(max-width: 900px) 100vw, 58vw', alt:image.alt | default:product.title }}</div>{% endfor %}</div><div class="product-summary reveal"><div class="eyebrow">{{ product.vendor | default:'HafHafHaf' }}</div><h1>{{ product.title }}</h1>{% if product.metafields.reviews.rating_count %}<div class="rating-badge"><span class="stars">★★★★★</span><strong>{{ product.metafields.reviews.rating.value.rating | round:1 }}</strong><span>{{ product.metafields.reviews.rating_count }} reviews</span></div>{% endif %}<div class="product-price">{{ product.price | money }}</div><div class="product-description">{{ product.description }}</div>{% form 'product', product, class:'product-buy' %}{% unless product.has_only_default_variant %}<label class="visually-hidden" for="ProductSelect">Choose an option</label><select id="ProductSelect" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} · Sold out{% endunless %} — {{ variant.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<div class="product-buy__row"><input type="number" name="quantity" min="1" value="1" aria-label="Quantity"><button class="button" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag · {{ product.price | money }}{% else %}Sold out{% endif %}</button></div>{% endform %}<div class="trust-row"><div>Secure checkout<br>Protected payment</div><div>Designed for daily life<br>Modern pet care</div><div>Support<br>Here when you need us</div></div><div class="pdp-reviews"><div class="eyebrow">Customer experience</div><h2>Made to become part of the routine.</h2><p style="color:var(--muted);line-height:1.7;font-size:14px;max-width:520px">We keep this section connected to verified customer feedback. Once your review source is connected, ratings and approved reviews can appear here automatically.</p></div></div></div></section>
{% schema %}{"name":"Premium product"}{% endschema %}