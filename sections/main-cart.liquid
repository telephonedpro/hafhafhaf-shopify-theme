<section class="cart-page page-width"><div class="eyebrow">Your bag</div><h1>Your essentials.</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post" id="cart"><div>{% for item in cart.items %}<div class="cart-row"><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 300 | image_tag }}{% endif %}</a><div><a class="cart-title" href="{{ item.url }}">{{ item.product.title }}</a><div class="cart-meta">Quantity {{ item.quantity }}</div></div><div class="line-price">{{ item.final_line_price | money }}</div></div>{% endfor %}</div><div class="cart-total"><span>Total</span><strong>{{ cart.total_price | money }}</strong></div><div style="display:flex;justify-content:flex-end"><button class="button" type="submit" name="checkout">Checkout</button></div></form>{% else %}<div class="empty">Your bag is currently empty. <a href="/collections/all"><u>Explore the collection.</u></a></div>{% endif %}</section>{% schema %}{"name":"Cart"}{% endschema %}