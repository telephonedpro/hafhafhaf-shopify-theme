<section class="cart-page page-width"><div class="eyebrow">Your bag</div><h1>Your essentials.</h1>{% if cart.item_count == 0 %}<div style="padding:50px 0;border-top:1px solid var(--line)"><p style="color:var(--muted)">Your bag is currently empty.</p><a class="button button--green" href="/collections/all">Explore the collection</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post" id="cart-form">{% for item in cart.items %}<div class="cart-line"><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width:600 | image_tag: loading:'lazy', widths:'200,300,450,600', sizes:'120px', alt:item.product.title }}{% endif %}</a><div><div class="cart-line__title">{{ item.product.title }}</div><div class="cart-line__price">{{ item.final_line_price | money }}</div><div style="margin-top:12px"><input name="updates[]" type="number" min="0" value="{{ item.quantity }}" aria-label="Quantity for {{ item.product.title }}" style="width:72px;height:40px;border:1px solid var(--line);border-radius:999px;text-align:center;background:var(--cream)"></div></div><div><a class="text-link" href="{{ item.url_to_remove }}">Remove <span>×</span></a></div></div>{% endfor %}<div class="cart-summary"><div class="cart-summary__row"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div><p style="font-size:10px;color:var(--muted);line-height:1.6">Shipping and taxes are calculated at checkout.</p><button class="button button--green" name="checkout" type="submit">Checkout securely</button><button class="button button--outline" name="update" type="submit" style="width:100%;margin-top:8px">Update bag</button></div></form>{% endif %}</section>{% schema %}{"name":"Premium cart"}{% endschema %}