<section class="cart-page page-width"><div class="eyebrow">Your bag</div><h1>Your essentials.</h1>{% if cart.item_count == 0 %}<div style="padding:50px 0;border-top:1px solid var(--line)"><p style="color:var(--muted)">Your bag is currently empty.</p><a class="button" href="/collections/all">Explore the collection</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post" id="cart-form">{% for item in cart.items %}<div class="cart-row"><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width:300 | image_tag: loading:'lazy', alt:item.product.title }}{% endif %}</a><div><div class="cart-row__title">{{ item.product.title }}</div><div class="cart-row__price">{{ item.final_line_price | money }}</div></div><div><input name="updates[]" type="number" min="0" value="{{ item.quantity }}" aria-label="Quantity for {{ item.product.title }}" style="width:70px;height:42px;border:1px solid var(--line);border-radius:999px;text-align:center;background:#fff"></div><a href="{{ item.url_to_remove }}" style="font-size:11px;color:var(--muted)">Remove</a></div>{% endfor %}<div class="cart-summary"><div class="cart-summary__box"><div class="cart-summary__total"><span>Total</span><span>{{ cart.total_price | money }}</span></div><button class="button" name="checkout" type="submit" style="width:100%">Checkout securely</button><button class="button button--ghost" name="update" type="submit" style="width:100%;margin-top:8px">Update bag</button></div></div></form>{% endif %}</section>{% schema %}{"name":"Premium cart"}{% endschema %}