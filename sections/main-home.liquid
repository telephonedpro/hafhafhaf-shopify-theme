{% assign hero_product = all_products['automatic-smart-cat-litter-box'] %}{% assign hero_image = section.settings.hero_image | default: hero_product.featured_image %}<section class="hero"><div class="hero__copy reveal"><div class="eyebrow">HafHafHaf · Intelligent pet care</div><h1>Better care.<br>Less routine.</h1><p>Smart products designed around the moments that matter — feeding, hygiene and peace of mind, beautifully simplified.</p><div class="hero__actions"><a class="button" href="/collections/all">Explore the collection</a><a class="button button--ghost" href="#featured">Discover the essentials</a></div></div><div class="hero__media">{% if hero_image %}{{ hero_image | image_url: width: 3840 | image_tag: loading:'eager', widths:'1200,1800,2400,3200,3840', sizes:'55vw', alt:'HafHafHaf smart pet care' }}{% endif %}<div class="hero__badge">{{ hero_product.title }} · {{ hero_product.price | money }}</div></div></section>

<section class="section page-width" id="featured"><div class="section-head reveal"><div><div class="eyebrow">The collection</div><h2>Technology that disappears into everyday life.</h2></div><p>Curated smart pet-care essentials, selected for convenience, reliability and a clean modern home.</p></div><div class="product-grid">{% assign featured_handles='automatic-smart-cat-litter-box,automatic-pet-feeder-with-camera,smart-pet-automatic-feeder-with-high-capacity,smart-automatic-pet-feeder-wifi-voice-control,smart-wifi-video-pet-automatic-feeder-with-timer,5l-smart-automatic-cat-feeder-with-camera-and-voice' | split: ',' %}{% for handle in featured_handles %}{% assign product = all_products[handle] %}{% if product %}<a class="product-card reveal" href="{{ product.url }}"><div class="product-card__media">{% if forloop.first %}<span class="product-card__tag">Flagship</span>{% endif %}{% if product.featured_image %}{{ product.featured_image | image_url: width: 2400 | image_tag: loading:'lazy', widths:'800,1200,1600,2000,2400', sizes:'(max-width: 900px) 50vw, 33vw', alt:product.title }}{% endif %}</div><div class="product-card__meta"><div><div class="product-card__title">{{ product.title }}</div>{% if product.metafields.reviews.rating_count %}<div class="price" style="margin-top:6px">★ {{ product.metafields.reviews.rating.value.rating | round:1 }} · {{ product.metafields.reviews.rating_count }} reviews</div>{% endif %}</div><div class="product-card__price">{{ product.price | money }}</div></div></a>{% endif %}{% endfor %}</div></section>

<div class="marquee"><div class="marquee__track"><span>Smarter feeding</span><span>Quiet routines</span><span>Cleaner spaces</span><span>More time together</span><span>Smarter feeding</span><span>Quiet routines</span><span>Cleaner spaces</span><span>More time together</span></div></div>

<section class="section page-width"><div class="split-feature reveal"><div class="split-feature__media">{% assign feature_product = all_products['automatic-smart-cat-litter-box'] %}{% if section.settings.feature_image %}{{ section.settings.feature_image | image_url: width:3840 | image_tag: loading:'lazy', widths:'1400,2200,3000,3840', sizes:'50vw', alt:'Automatic smart cat litter box' }}{% elsif feature_product.images[1] %}{{ feature_product.images[1] | image_url: width:3840 | image_tag: loading:'lazy', widths:'1400,2200,3000,3840', sizes:'50vw', alt:feature_product.title }}{% else %}{{ feature_product.featured_image | image_url: width:3840 | image_tag: loading:'lazy', widths:'1400,2200,3000,3840', sizes:'50vw', alt:feature_product.title }}{% endif %}</div><div class="split-feature__copy"><div class="eyebrow" style="color:#aaa">The HafHafHaf flagship</div><h2>Clean starts with a smarter routine.</h2><p>A fully automatic litter system designed to reduce the daily work around pet hygiene while keeping the experience simple for you and comfortable for your cat.</p><a class="button button--light" href="{{ feature_product.url }}">Shop the flagship · {{ feature_product.price | money }}</a></div></div></section>

<section class="section section--tight page-width"><div class="benefits reveal"><div class="benefit"><div class="benefit__num">01</div><strong>Precision</strong><p>Smart routines and measured portions designed for consistency.</p></div><div class="benefit"><div class="benefit__num">02</div><strong>Connection</strong><p>Stay closer to your pet with connected cameras and app control.</p></div><div class="benefit"><div class="benefit__num">03</div><strong>Less routine</strong><p>Automate repetitive care so your attention stays where it belongs.</p></div><div class="benefit"><div class="benefit__num">04</div><strong>Quiet design</strong><p>Products that belong in a modern home rather than compete with it.</p></div></div></section>

{% assign has_reviews = false %}{% for block in section.blocks %}{% if block.settings.quote != blank %}{% assign has_reviews = true %}{% endif %}{% endfor %}{% if has_reviews %}<section class="section page-width"><div class="reviews reveal"><div class="reviews__head"><div class="eyebrow">Real customer feedback</div><h2>Loved by pet parents.</h2><p>Verified customer stories belong here. Connect your review source or add approved testimonials in the theme editor — no invented social proof.</p></div><div class="reviews-grid">{% for block in section.blocks %}{% if block.settings.quote != blank %}<article class="review" {{ block.shopify_attributes }}><div class="review__stars">★★★★★</div><div class="review__quote">“{{ block.settings.quote }}”</div><div class="review__name">{{ block.settings.name }}{% if block.settings.product != blank %} · {{ block.settings.product }}{% endif %}</div></article>{% endif %}{% endfor %}</div></div></section>{% endif %}

<section class="section page-width"><div class="newsletter reveal"><div><div class="eyebrow" style="color:#9e9c94">The HafHafHaf journal</div><h2>Better care starts with better routines.</h2><p>New products, practical pet-care ideas and occasional private offers. No noise.</p></div>{% form 'customer' %}<input type="hidden" name="contact[tags]" value="newsletter"><div class="newsletter form"><input type="email" name="contact[email]" placeholder="Email address" aria-label="Email address" required><button class="button button--light" type="submit">Join us</button></div>{% endform %}</div></section>
{% schema %}{"name":"Premium homepage","settings":[{"type":"image_picker","id":"hero_image","label":"Hero image (use a real product/lifestyle photo)"},{"type":"image_picker","id":"feature_image","label":"Flagship feature image"}],"blocks":[{"type":"review","name":"Verified review","settings":[{"type":"textarea","id":"quote","label":"Approved customer quote"},{"type":"text","id":"name","label":"Customer name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Premium homepage","blocks":[]}]}{% endschema %}