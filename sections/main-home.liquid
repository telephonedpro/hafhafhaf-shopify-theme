{% assign hero_product = all_products['automatic-smart-cat-litter-box'] %}
{% assign hero_image = section.settings.hero_image | default: hero_product.featured_image %}

<div class="announcement"><div class="announcement__track"><span>SMARTER PET CARE</span><span>DESIGNED FOR MODERN HOMES</span><span>FREE SHIPPING ON QUALIFYING ORDERS</span><span>SMARTER PET CARE</span><span>DESIGNED FOR MODERN HOMES</span><span>FREE SHIPPING ON QUALIFYING ORDERS</span></div></div>

<section class="hero">
  <div class="hero__copy reveal">
    <div class="eyebrow">HafHafHaf · Intelligent pet care</div>
    <h1>Good care,<br><em>beautifully</em> automated.</h1>
    <p>Smart feeding, hygiene and connected care for people who want more time with their pets — and less time managing routines.</p>
    <div class="hero__actions"><a class="button" href="/collections/all">Shop smart care</a><a class="text-link" href="#story">Our approach <span>↗</span></a></div>
    <div class="hero__micro"><span>01</span><span>Thoughtful technology</span><span>·</span><span>Everyday comfort</span></div>
  </div>
  <div class="hero__media">
    {% if hero_image %}{{ hero_image | image_url: width: 3840 | image_tag: loading:'eager', widths:'1200,1800,2400,3200,3840', sizes:'55vw', alt:'HafHafHaf smart pet care' }}{% endif %}
    <div class="hero__caption"><span>01 / {{ hero_product.title }}</span><span>{{ hero_product.price | money }}</span></div>
  </div>
</section>

<section class="proof-strip page-width reveal">
  <div><strong>Smart routines</strong><span>Automate the everyday</span></div>
  <div><strong>Connected care</strong><span>Stay close, even away</span></div>
  <div><strong>Modern design</strong><span>Made to belong at home</span></div>
  <div><strong>Real support</strong><span>Human help when needed</span></div>
</section>

<section class="section page-width" id="featured">
  <div class="section-head reveal"><div><div class="eyebrow">01 · The collection</div><h2>Products with a purpose.</h2></div><p>We keep the collection intentionally focused: fewer products, better reasons to own them.</p></div>
  <div class="product-grid">
    {% assign featured_handles='automatic-smart-cat-litter-box,automatic-pet-feeder-with-camera,smart-pet-automatic-feeder-with-high-capacity,smart-automatic-pet-feeder-wifi-voice-control,smart-wifi-video-pet-automatic-feeder-with-timer,5l-smart-automatic-cat-feeder-with-camera-and-voice' | split: ',' %}
    {% for handle in featured_handles %}{% assign product = all_products[handle] %}{% if product %}
      <a class="product-card reveal" href="{{ product.url }}">
        <div class="product-card__media">{% if forloop.first %}<span class="product-card__tag">Flagship</span>{% endif %}{% if product.featured_image %}{{ product.featured_image | image_url: width: 2400 | image_tag: loading:'lazy', widths:'800,1200,1600,2000,2400', sizes:'(max-width: 900px) 50vw, 33vw', alt:product.title }}{% endif %}<span class="product-card__arrow">↗</span></div>
        <div class="product-card__meta"><div><div class="product-card__title">{{ product.title }}</div>{% if product.metafields.reviews.rating_count and product.metafields.reviews.rating.value.rating %}<div class="rating-line"><span class="stars">★★★★★</span> {{ product.metafields.reviews.rating.value.rating | round:1 }} <u>{{ product.metafields.reviews.rating_count }} reviews</u></div>{% endif %}</div><div class="product-card__price">{{ product.price | money }}</div></div>
      </a>
    {% endif %}{% endfor %}
  </div>
</section>

<div class="marquee"><div class="marquee__track"><span>Smarter feeding</span><i>✦</i><span>Quiet routines</span><i>✦</i><span>Cleaner spaces</span><i>✦</i><span>More time together</span><i>✦</i><span>Smarter feeding</span><i>✦</i><span>Quiet routines</span><i>✦</i><span>Cleaner spaces</span><i>✦</i><span>More time together</span></div></div>

<section class="section page-width" id="story">
  <div class="story-grid reveal">
    <div class="story-image">{% if section.settings.story_image %}{{ section.settings.story_image | image_url: width:3840 | image_tag: loading:'lazy', widths:'1400,2200,3000,3840', sizes:'52vw', alt:'HafHafHaf pet care lifestyle' }}{% elsif hero_product.images[1] %}{{ hero_product.images[1] | image_url: width:3840 | image_tag: loading:'lazy', widths:'1400,2200,3000,3840', sizes:'52vw', alt:hero_product.title }}{% endif %}<span class="image-note">Designed around real routines.</span></div>
    <div class="story-copy"><div class="eyebrow">02 · Our approach</div><h2>Technology should feel <em>quiet.</em></h2><p>Our products are chosen for one simple reason: they should make pet care easier without making your home feel like a machine.</p><div class="story-list"><div><b>01</b><span>Less repetitive work</span></div><div><b>02</b><span>More visibility when you're away</span></div><div><b>03</b><span>Better everyday consistency</span></div></div><a class="text-link" href="/pages/about">Read our philosophy <span>↗</span></a></div>
  </div>
</section>

<section class="section section--dark page-width">
  <div class="flagship reveal">
    <div class="flagship__copy"><div class="eyebrow">03 · The flagship</div><h2>Clean starts with a smarter routine.</h2><p>A fully automatic litter system designed to reduce the daily work around pet hygiene while keeping the experience simple for you and comfortable for your cat.</p><div class="flagship__price">{{ hero_product.price | money }} <span>· flagship system</span></div><a class="button button--light" href="{{ hero_product.url }}">Discover the litter box</a></div>
    <div class="flagship__media">{% if section.settings.feature_image %}{{ section.settings.feature_image | image_url: width:3840 | image_tag: loading:'lazy', widths:'1400,2200,3000,3840', sizes:'50vw', alt:hero_product.title }}{% elsif hero_product.images[1] %}{{ hero_product.images[1] | image_url: width:3840 | image_tag: loading:'lazy', widths:'1400,2200,3000,3840', sizes:'50vw', alt:hero_product.title }}{% else %}{{ hero_product.featured_image | image_url: width:3840 | image_tag: loading:'lazy', widths:'1400,2200,3000,3840', sizes:'50vw', alt:hero_product.title }}{% endif %}</div>
  </div>
</section>

<section class="section page-width">
  <div class="section-head reveal"><div><div class="eyebrow">04 · Why HafHafHaf</div><h2>Designed to disappear into your life.</h2></div><p>Every detail should earn its place — from the routine it automates to the space it occupies.</p></div>
  <div class="benefits reveal"><div class="benefit"><div class="benefit__num">01</div><strong>Precision</strong><p>Consistent routines and measured portions, built around everyday use.</p></div><div class="benefit"><div class="benefit__num">02</div><strong>Connection</strong><p>Connected features that help you stay informed without hovering.</p></div><div class="benefit"><div class="benefit__num">03</div><strong>Less routine</strong><p>Automate repetitive care and make room for the moments that matter.</p></div><div class="benefit"><div class="benefit__num">04</div><strong>Quiet design</strong><p>Modern objects that belong in a considered home.</p></div></div>
</section>

{% assign has_reviews = false %}{% for block in section.blocks %}{% if block.settings.quote != blank %}{% assign has_reviews = true %}{% endif %}{% endfor %}
{% if has_reviews %}<section class="section page-width"><div class="reviews reveal"><div class="reviews__head"><div class="eyebrow">05 · Customer stories</div><h2>Good products should earn trust.</h2><p>Approved customer reviews are displayed here exactly as entered — no invented social proof.</p></div><div class="reviews-grid">{% for block in section.blocks %}{% if block.settings.quote != blank %}<article class="review" {{ block.shopify_attributes }}><div class="review__stars">★★★★★</div><div class="review__quote">“{{ block.settings.quote }}”</div><div class="review__name">{{ block.settings.name }}{% if block.settings.product != blank %} · {{ block.settings.product }}{% endif %}</div></article>{% endif %}{% endfor %}</div></div></section>{% endif %}

<section class="section page-width"><div class="newsletter reveal"><div><div class="eyebrow" style="color:#aaa89f">The HafHafHaf journal</div><h2>Better care starts with better routines.</h2><p>New products, practical pet-care ideas and occasional private offers. No noise.</p></div>{% form 'customer' %}<input type="hidden" name="contact[tags]" value="newsletter"><div class="newsletter form"><input type="email" name="contact[email]" placeholder="Email address" aria-label="Email address" required><button class="button button--light" type="submit">Join us</button></div>{% endform %}</div></section>

{% schema %}{"name":"Premium homepage","settings":[{"type":"image_picker","id":"hero_image","label":"Hero image — use a real high-resolution product/lifestyle photo"},{"type":"image_picker","id":"story_image","label":"Story/lifestyle image"},{"type":"image_picker","id":"feature_image","label":"Flagship image"}],"blocks":[{"type":"review","name":"Approved review","settings":[{"type":"textarea","id":"quote","label":"Approved customer quote"},{"type":"text","id":"name","label":"Customer name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Premium homepage","blocks":[]}]}{% endschema %}